# ================================
# CAREER PORTFOLIO MANAGER API
# Enterprise Configuration Example
# ================================

# ================================
# ENVIRONMENT
# ================================
NODE_ENV=development              # development | production | test
PORT=5000

# ================================
# DATABASE (REQUIRED)
# ================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/career_portfolio

# ================================
# JWT AUTHENTICATION (REQUIRED)
# ================================
# CRITICAL: Must be at least 32 characters
# Generate with: openssl rand -base64 32
# NEVER use default values in production!
JWT_SECRET=change-this-to-a-strong-random-secret-minimum-32-chars
JWT_EXPIRES_IN=7d                 # Token expiration: 7d, 30d, etc.

# ================================
# FRONTEND URL (REQUIRED)
# ================================
# Used for CORS configuration
# Production example: https://career-portfolio.com
FRONTEND_URL=http://localhost:5173

# ================================
# EMAIL CONFIGURATION (REQUIRED)
# ================================
# SMTP settings for sending verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                 # true for 465, false for other ports
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password  # Use app password, not account password
SMTP_FROM=Career Portfolio <noreply@career-portfolio.com>

# Gmail Users: Enable 2FA and generate app password:
# https://support.google.com/accounts/answer/185833

# ================================
# SECURITY (REQUIRED)
# ================================

# Password hashing strength (12-14 recommended)
BCRYPT_ROUNDS=12

# Cookie signing secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
COOKIE_SECRET=change-this-to-a-strong-random-secret-minimum-32-chars

# ================================
# RATE LIMITING
# ================================
# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window

# Authentication endpoints (stricter)
RATE_LIMIT_AUTH_MAX=5             # Max auth attempts per window

# ================================
# REDIS (OPTIONAL - for caching)
# ================================
# Redis connection URL for caching and session management
# REDIS_URL=redis://localhost:6379

# ================================
# MONITORING & LOGGING (OPTIONAL)
# ================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level: error | warn | info | http | debug
LOG_LEVEL=info

# ================================
# FILE STORAGE (OPTIONAL)
# ================================
# AWS S3 for file uploads (future enhancement)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=career-portfolio-uploads

# ================================
# FEATURE FLAGS (OPTIONAL)
# ================================
# Enable/disable features
# FEATURE_JOB_MATCHING=true
# FEATURE_SKILLS_GAP=true
# FEATURE_EMAIL_NOTIFICATIONS=true

# ================================
# PRODUCTION CHECKLIST
# ================================
# Before deploying to production:
# ✓ Change all secrets to strong random values
# ✓ Set NODE_ENV=production
# ✓ Use HTTPS (not HTTP) for FRONTEND_URL
# ✓ Enable database connection encryption
# ✓ Set up log aggregation
# ✓ Configure monitoring (Sentry, DataDog, etc.)
# ✓ Set up automated backups
# ✓ Review rate limits for expected load
# ✓ Test all endpoints with new configuration
# ✓ Run security audit: npm audit
# ✓ Run tests: npm test
