# Test Environment Configuration
# DO NOT use these values in production!

NODE_ENV=test
PORT=5001

# Database (use separate test database)
DATABASE_URL=postgresql://test:test@localhost:5432/career_portfolio_test

# JWT Configuration (test secrets - minimum 32 characters)
JWT_SECRET=test-jwt-secret-minimum-32-characters-long-for-testing-purposes
JWT_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=test-cookie-secret-minimum-32-characters-long-for-testing

# Password Hashing
BCRYPT_ROUNDS=12

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting (same as production for testing)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# Email Configuration (mock for tests)
SMTP_HOST=smtp.test.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@test.com
SMTP_PASS=testpassword
SMTP_FROM=Test Career Portfolio <noreply@test.com>

# Logging
LOG_LEVEL=error
